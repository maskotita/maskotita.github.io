---
/**
 * LOGOTIPO — logotipo oficial de Maskotita.
 *
 * El archivo original (1536×1024) está en:
 *     https://maskotita.com.ar/logo.png
 *
 * Ya viene recortado a 800×253 y optimizado (~90 KB) en:
 *     public/images/logo-maskotita.png
 *
 * Para reemplazarlo por otra versión, poné el archivo acá y actualizá
 * `width` y `height` (o `srcset`) con las medidas reales.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<img
  src="/images/logo-maskotita.png"
  alt="Maskotita"
  class={`logo-slot object-contain ${className}`}
  width="800"
  height="253"
  decoding="async"
  data-logo
/>
